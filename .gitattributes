* text=auto

*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.ps1 text eol=crlf

*.png binary
*.ico binary
*.exe binary

# This vendored tree is verified by a byte-for-byte SHA256 manifest. Preserve
# upstream line endings and whitespace exactly on every platform.
internal/opensciskill/defaultskills/** -text whitespace=-trailing-space,-blank-at-eof
